{
  "schema_version": "1.0",
  "description": "Leakage-free LogRobust-style attention Bi-LSTM training configuration for HDFS block splits.",
  "data": {
    "train": "research/data/processed/hdfs_block_evidence_train.jsonl.gz",
    "validation": "research/data/processed/hdfs_block_evidence_validation.jsonl.gz",
    "test": "research/data/processed/hdfs_block_evidence_test.jsonl.gz",
    "vocabulary": "research/models/vocabularies/event_vocabulary.json",
    "output_dir": "research/models/checkpoints/logrobust_attention_bilstm",
    "seed": 13,
    "architecture": "logrobust_attention_bilstm"
  },
  "training": {
    "max_sequence_length": 50,
    "padding": "post",
    "truncating": "pre",
    "embedding_dim": 128,
    "bilstm_units": 128,
    "attention_units": 64,
    "dense_units": 32,
    "bilstm_dropout": 0.3,
    "dense_dropout": 0.2,
    "mask_zero": true,
    "learning_rate": 0.001,
    "batch_size": 128,
    "prediction_batch_size": 256,
    "epochs": 20,
    "early_stopping_patience": 3,
    "reduce_lr_patience": 2,
    "threshold": 0.5,
    "deterministic": true,
    "use_class_weights": true
  }
}
